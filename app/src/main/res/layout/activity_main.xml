<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jarvis_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="J.A.R.V.I.S"
            android:textColor="@color/jarvis_cyan"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/jarvis_text_dim"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:text="00:00:00"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙"
            android:textColor="@color/jarvis_cyan"
            android:backgroundTint="@color/jarvis_bg_panel" />
    </LinearLayout>

    <com.example.jarvis.StatusRingView
        android:id="@+id/statusRing"
        android:layout_width="match_parent"
        android:layout_height="220dp" />

    <TextView
        android:id="@+id/statusLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="STANDBY"
        android:textColor="@color/jarvis_cyan"
        android:textStyle="bold"
        android:textSize="16sp"
        android:letterSpacing="0.2"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/wakeToggleButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎙 HEY JARVIS: OFF"
        android:textColor="@color/jarvis_cyan"
        android:backgroundTint="@color/jarvis_bg_panel"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/jarvis_bg_panel"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/cityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your city (weather)"
            android:textColorHint="@color/jarvis_text_dim"
            android:textColor="@color/jarvis_text"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/youtubeKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="YouTube API key"
            android:textColorHint="@color/jarvis_text_dim"
            android:textColor="@color/jarvis_text"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/tvIpInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="TV IP address"
            android:textColorHint="@color/jarvis_text_dim"
            android:textColor="@color/jarvis_text"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/tvMacInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="TV MAC address (for power-on)"
            android:textColorHint="@color/jarvis_text_dim"
            android:textColor="@color/jarvis_text"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE SETTINGS"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/jarvis_cyan_dim"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/jarvis_bg_panel"
        android:padding="10dp"
        android:layout_marginBottom="10dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/chatLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/jarvis_text"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/micButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIC"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/jarvis_mic"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:hint="&gt; enter command"
            android:textColorHint="@color/jarvis_text_dim"
            android:textColor="@color/jarvis_text"
            android:background="@color/jarvis_bg_panel"
            android:fontFamily="monospace"
            android:padding="10dp" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEND"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/jarvis_cyan_dim"
            android:fontFamily="monospace" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Gemini API key"
            android:inputType="textPassword"
            android:textColorHint="@color/jarvis_text_dim"
            android:textColor="@color/jarvis_text"
            android:background="@color/jarvis_bg_panel"
            android:fontFamily="monospace"
            android:padding="8dp" />

        <Button
            android:id="@+id/saveKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAVE"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/jarvis_cyan_dim"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STOP"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:fontFamily="monospace" />
    </LinearLayout>

</LinearLayout>
